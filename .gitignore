__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.vscode/
.idea/

# PyInstaller output — produced locally by scripts/build.ps1 and
# shipped to end users via GitHub Releases, not the repo. Ignore
# everything under bin/ (the Windows .exe and the renamed Linux
# binary bin/harness-linux) EXCEPT bin/harness itself: that name is
# a committed POSIX dispatcher (#53), not build output — every
# launch point (hooks.json, both MCP manifests) names it directly,
# so it must ship from a bare dev checkout too, not just from
# release.yml's staging copy.
/bin/*
!/bin/harness
*.pyinstaller.tmp/
.adev/
.serena/

# Committed MCP test-project settings (globally ignored otherwise)
!mcp-test/.claude/settings.local.json
.ape/
